# Bharat Heritage Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Backend API base URL for Render deployment / self-hosted backend
# Defaults to Bharat Heritage production API endpoint
BACKEND_API_BASE_URL=https://bharat-heritage-api.onrender.com
