# Bharat Heritage - Web, Backend & Mobile Ecosystem Configuration

# ---------------------------------------------------------------------------------
# 1. SERVER & PORT (Render automatically assigns PORT)
# ---------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ---------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Used by server /api/ai/chat and voice assistants)
# ---------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (Used by server to verify ID tokens for Phone Auth)
# ---------------------------------------------------------------------------------
# Firebase Project ID (found in Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=bharat-heritage

# Service account client email (from downloaded service account JSON)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bharat-heritage.iam.gserviceaccount.com

# Service account private key (enclose in quotes, keep \n preserved)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------------
# 4. FRONTEND VITE PUBLIC VARIABLES (Prefix with VITE_ to expose to browser)
# ---------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExampleKey12345
VITE_FIREBASE_AUTH_DOMAIN=bharat-heritage.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bharat-heritage
VITE_FIREBASE_STORAGE_BUCKET=bharat-heritage.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Public Backend URL (leave empty or set to Render URL if hosted separately)
VITE_BACKEND_API_BASE_URL=https://bharat-heritage-api.onrender.com

# ---------------------------------------------------------------------------------
# 5. ANDROID APP COMPATIBILITY
# ---------------------------------------------------------------------------------
BACKEND_API_BASE_URL=https://bharat-heritage-api.onrender.com
